SESSION_DATABASE_URL=postgresql+psycopg://conversation:URL_ENCODED_PASSWORD@127.0.0.1:5432/session-db
OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
ALLOWED_USER_DOMAINS=example.com
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
ASSISTANT_MODEL=gemini-2.5-flash
MCP_URL=https://YOUR_PRIVATE_MCP/mcp
MCP_CLOUD_RUN_AUDIENCE=https://YOUR_PRIVATE_MCP
# Must match the client's validated user-delegation contract.
MCP_USER_AUTH_HEADER=X-User-Authorization
