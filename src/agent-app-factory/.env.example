# Only this batch job receives the Durable State DB connection.
DURABLE_DATABASE_URL=postgresql+psycopg://batch:URL_ENCODED_PASSWORD@127.0.0.1:5432/durable-state-db
# Alternatively configure DURABLE_CLOUD_SQL_INSTANCE, DURABLE_DB_USER,
# DURABLE_DB_PASSWORD (or DURABLE_DB_IAM_AUTH=true), and DURABLE_DB_NAME.
MCP_URL=https://YOUR_PRIVATE_MCP/mcp
MCP_CLOUD_RUN_AUDIENCE=https://YOUR_PRIVATE_MCP
MCP_TIMEOUT_SECONDS=90
# Optional application-level MCP credential; use secret injection in Cloud Run.
# MCP_BEARER_TOKEN=
