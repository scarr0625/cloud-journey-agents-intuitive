# Business and session access use Schwab MCP. No DB credentials on agents.
OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
ALLOWED_USER_DOMAINS=example.com
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
ORCHESTRATOR_MODEL=gemini-2.5-flash
ASSISTANT_URL=https://YOUR_ASSISTANT_SERVICE
ASSISTANT_CLOUD_RUN_AUDIENCE=https://YOUR_ASSISTANT_SERVICE
MCP_URL=https://YOUR_PRIVATE_MCP/mcp
MCP_CLOUD_RUN_AUDIENCE=https://YOUR_PRIVATE_MCP
MCP_USER_AUTH_HEADER=X-User-Authorization
