# PostgreSQL / Cloud SQL (use the Cloud SQL Auth Proxy endpoint locally)
DATABASE_URL=postgresql+psycopg://journey:URL_ENCODED_PASSWORD@127.0.0.1:5432/durable_journey

# Choose one Google ADK authentication mode.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=replace-with-a-Gemini-API-key

# When using Vertex AI instead:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

ORCHESTRATOR_MODEL=gemini-2.5-flash
INVENTORY_AGENT_URL=
APM_AGENT_URL=
REQUEST_TIMEOUT_SECONDS=90

# Required for durable Journey access. If omitted, only service-level specialist
# routing and general questions are available.
OAUTH_CLIENT_ID=
ALLOWED_USER_DOMAINS=
SQL_ECHO=false
